# RAG Service Configuration
# Copy to .env and adjust as needed. All values have sensible defaults.

# Server
GRPC_PORT=9090
HTTP_PORT=8080
LOG_LEVEL=info
# ENVIRONMENT=development  # Set to "production" to enforce secure defaults

# Auth (required in non-development environments)
# ADMIN_API_KEY=your-admin-api-key-here
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# PostgreSQL
DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable

# Qdrant
QDRANT_URL=http://localhost:6333

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2

# RAG defaults (optional)
DEFAULT_CHUNK_METHOD=semantic
DEFAULT_TOP_K=4
DEFAULT_MIN_SCORE=0.35

# LLM provider: "ollama" (native Ollama API) or "openai" (OpenAI-compatible:
# llama.cpp llama-server, vLLM, ...)
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:8081/v1
# EMBEDDING_BASE_URL=http://localhost:8082/v1
# LLM_API_KEY=
# EMBEDDING_DIMENSION=768

# RAG pipeline
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_TIMEOUT=10s
# CONTEXTUAL_CONCURRENCY=2

# Defaults for new tenants
# DEFAULT_HYBRID_ENABLED=true
# DEFAULT_RERANKER_ENABLED=false
# DEFAULT_CONTEXTUAL_RETRIEVAL=false

# Self-serve signup: lets client installs (e.g. the browser extension)
# register themselves via POST /v1/signup with a generated ULID. Signup
# tenants are reaped after SIGNUP_RETENTION_DAYS of inactivity.
# SIGNUP_ENABLED=false
# SIGNUP_RETENTION_DAYS=30
# RETENTION_SWEEP_INTERVAL=1h
